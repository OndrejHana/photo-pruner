{
  "name": "photo-pruner",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.26",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-image": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.2",
    "cbor-x": "^1.6.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test src/domain/*.test.ts tests/ui/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "build:sim": "eas build --platform ios --profile development-simulator",
    "start:tunnel": "expo start --dev-client --tunnel",
    "lint": "eslint App.tsx src modules --max-warnings 0"
  },
  "private": true
}
